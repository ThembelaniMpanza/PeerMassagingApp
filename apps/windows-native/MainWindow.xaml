<Window x:Class="IPMessenger.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IP Messenger" Width="1160" Height="820" MinWidth="900" MinHeight="650" Background="#F4F1EB" Closing="Window_Closing">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#173B35" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top">
<TextBlock Text="IP MESSENGER" Foreground="#B7CEC2" FontWeight="Bold"/><TextBlock Text="Nearby peers" Foreground="White" FontSize="28" Margin="0,20,0,12"/><TextBlock x:Name="LocalText" Foreground="#B7CEC2" TextWrapping="Wrap"/>
<Button Content="Refresh discovery" Click="Refresh_Click" Margin="0,12"/><TextBlock Text="Connect by IPv4 address and port" Foreground="White"/><TextBox x:Name="AddressBox" AutomationProperties.AutomationId="AddressBox" Text="127.0.0.1:15050" Margin="0,6"/><Button Content="Connect" AutomationProperties.AutomationId="ConnectButton" Click="Connect_Click"/><TextBlock Text="Emulator: connect from mobile to 10.0.2.2:5050" Foreground="#B7CEC2" TextWrapping="Wrap" Margin="0,8,0,16"/>
</StackPanel><ListBox x:Name="DevicesList" AutomationProperties.AutomationId="DevicesList" SelectionChanged="DevicesList_SelectionChanged" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,10"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="SelectedPeerText" Text="Select a peer" FontSize="26" Foreground="#173B35"/><TextBlock x:Name="StatusText" Foreground="#63736B"/><WrapPanel><Button x:Name="PairButton" Content="Pair device" Click="Pair_Click" AutomationProperties.AutomationId="PairButton"/><Button Content="Reconnect" Click="Reconnect_Click"/><Button Content="Forget pairing" Click="Forget_Click"/></WrapPanel></StackPanel>
<TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="#AA3322" TextWrapping="Wrap" Margin="0,5" AutomationProperties.AutomationId="ErrorText"/>
<StackPanel Grid.Row="2"><Border x:Name="OutgoingPanel" Visibility="Collapsed" Background="#E4EEDC" Padding="10" Margin="0,5"><TextBlock x:Name="OutgoingText" TextWrapping="Wrap" AutomationProperties.AutomationId="OutgoingText"/></Border><Border x:Name="IncomingPanel" Visibility="Collapsed" Background="#FFF0D5" Padding="10" Margin="0,5"><StackPanel><TextBlock x:Name="IncomingText" TextWrapping="Wrap"/><WrapPanel><TextBox x:Name="PairCodeBox" Width="110" MaxLength="6" AutomationProperties.AutomationId="PairCodeBox"/><Button Content="Approve pairing" Click="Approve_Click" AutomationProperties.AutomationId="ApproveButton"/><Button Content="Decline" Click="Decline_Click"/></WrapPanel></StackPanel></Border></StackPanel>
<Border Grid.Row="3" Background="#FFFDF8" Padding="10" Margin="0,8"><ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MessagesList" AutomationProperties.AutomationId="MessagesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#EEECE5" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="#173B35"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding State}" FontSize="11" Foreground="#63736B"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
<GroupBox Grid.Row="4" Header="File transfers · maximum 10 MB"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TransfersList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><WrapPanel><Button Content="Accept" Tag="{Binding Id}" Click="AcceptFile_Click" IsEnabled="{Binding CanAccept}"/><Button Content="Decline" Tag="{Binding Id}" Click="RejectFile_Click" IsEnabled="{Binding CanAccept}"/><Button Content="Cancel" Tag="{Binding Id}" Click="CancelFile_Click" IsEnabled="{Binding Active}"/><Button Content="Show saved file" Tag="{Binding SavedPath}" Click="ShowFile_Click" IsEnabled="{Binding CanShow}"/></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></GroupBox>
<DockPanel Grid.Row="5" Margin="0,8"><Button DockPanel.Dock="Right" Content="Send file" Click="SendFile_Click" AutomationProperties.AutomationId="SendFileButton"/><Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click"/><TextBox x:Name="FilePathBox" AutomationProperties.AutomationId="FilePathBox" ToolTip="Path to a file to send"/></DockPanel>
<DockPanel Grid.Row="6"><Button DockPanel.Dock="Right" Content="Send" Click="Send_Click" AutomationProperties.AutomationId="SendButton"/><TextBox x:Name="MessageBox" AutomationProperties.AutomationId="MessageBox" KeyDown="MessageBox_KeyDown" ToolTip="Type a message"/></DockPanel>
</Grid></Grid></Window>
