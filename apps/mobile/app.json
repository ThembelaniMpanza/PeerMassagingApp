{
  "expo": {
    "name": "IP Messenger",
    "slug": "ip-messenger",
    "scheme": "ip-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.ipmessenger.mobile",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "ACCESS_WIFI_STATE", "CHANGE_WIFI_MULTICAST_STATE"]
    },
    "ios": {
      "bundleIdentifier": "com.ipmessenger.mobile",
      "infoPlist": { "NSLocalNetworkUsageDescription": "Find nearby devices and exchange messages and files on your local network." }
    },
    "plugins": ["expo-dev-client", "expo-secure-store", "expo-document-picker"],
    "experiments": {
      "tsconfigPaths": true,
      "autolinkingModuleResolution": true
    }
  }
}
